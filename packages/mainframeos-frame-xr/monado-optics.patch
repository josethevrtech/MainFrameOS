+// Bilinear lookup in the captured optical reference. XRT_MESH_SIZE=128 matches its vertices.
+static xrt_result_t
+frame_compute_distortion(struct xrt_device *xdev, uint32_t view, float u, float v, struct xrt_uv_triplet *out)
+{
+ (void)xdev;
+ if(view>=2 || !isfinite(u) || !isfinite(v) || u<0 || u>1 || v<0 || v>1) return XRT_ERROR_INPUT_UNSUPPORTED;
+ float x=u*FRAME_OPTICS_CELLS,y=v*FRAME_OPTICS_CELLS;
+ int ix=(int)x,iy=(int)y;
+ if(ix==FRAME_OPTICS_CELLS)ix--;
+ if(iy==FRAME_OPTICS_CELLS)iy--;
+ float a=x-ix,b=y-iy,uv[6];
+ int stride=FRAME_OPTICS_CELLS+1;
+ for(int k=0;k<6;k++)uv[k]=(1-a)*(1-b)*frame_uv[view][iy*stride+ix][k] + a*(1-b)*frame_uv[view][iy*stride+ix+1][k] + (1-a)*b*frame_uv[view][(iy+1)*stride+ix][k] + a*b*frame_uv[view][(iy+1)*stride+ix+1][k];
+ out->r=(struct xrt_vec2){uv[0],uv[1]};out->g=(struct xrt_vec2){uv[2],uv[3]};out->b=(struct xrt_vec2){uv[4],uv[5]};
+ return XRT_SUCCESS;
+}
