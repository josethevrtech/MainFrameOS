--- a/src/xrt/drivers/remote/r_internal.h
+++ b/src/xrt/drivers/remote/r_internal.h
@@ -16,6 +16,8 @@
 #include "xrt/xrt_tracking.h"
 
 #include "os/os_threading.h"
+#include "os/os_time.h"
+#include <math.h>
 
 #include "util/u_hand_tracking.h"
 
@@ -45,6 +47,7 @@ struct r_hub
 
 	//! The latest data received.
 	struct r_remote_data latest;
+	struct os_mutex latest_mutex;
 
 	//! Incoming connection socket.
 	r_socket_t accept_fd;
@@ -66,6 +69,31 @@ struct r_hub
 	} gui;
 };
 
+// Local-only diagnostic wire format; consumers never infer tracking from finite data.
+static inline void
+r_hub_snapshot(struct r_hub *r, struct r_remote_data *out)
+{
+ os_mutex_lock(&r->latest_mutex);
+ *out = r->latest;
+ os_mutex_unlock(&r->latest_mutex);
+ uint64_t now = os_monotonic_get_ns();
+ const struct xrt_pose *p = &out->head.center;
+ double q = (double)p->orientation.x*p->orientation.x + (double)p->orientation.y*p->orientation.y +
+            (double)p->orientation.z*p->orientation.z + (double)p->orientation.w*p->orientation.w;
+ bool fresh = out->sample_monotonic_ns != 0 && out->sample_monotonic_ns <= now &&
+              now-out->sample_monotonic_ns <= 100000000;
+ bool finite_pose = isfinite(p->position.x) && isfinite(p->position.y) && isfinite(p->position.z) &&
+                    isfinite(q) && fabs(q-1.0) < 0.001;
+ if (!fresh || !finite_pose || out->header != R_HEADER_VALUE || out->reserved != 0) {
+  out->relation_flags = 0;
+ }
+ // This development path has no validated tracking-quality source yet.
+ // It may expose estimated poses but must never claim orientation/position TRACKED.
+ out->relation_flags &= XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_POSITION_VALID_BIT;
+ out->left.active = out->right.active = false;
+ out->left.hand_tracking_active = out->right.hand_tracking_active = false;
+}
